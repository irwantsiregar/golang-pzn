{{/* 183. Template Action */}}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{.Title}}</title>
  </head>
  <body>
  {{if .Name}}
    <h1>Hello, {{.Name}}</h1>
  {{else if .About.Role }}
    <h2>Role: {{.About.Role}}</h2>
  {{else}}
    <h1>Hello</h1>
  {{end}}
  </body>
</html>
